{
  "name": "@cuckoo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cuckoo/shared": "workspace:*",
    "bullmq": "^6.4.1",
    "ioredis": "^5.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsc-watch": "^7.2.1",
    "vitest": "^5.0.5"
  }
}
