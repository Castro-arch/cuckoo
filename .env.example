# Copy to .env and adjust. The api and worker load ../../.env automatically
# (node --env-file-if-exists); docker compose reads it for port/credential overrides.

# --- Docker Compose (PostgreSQL 16 + Redis 7) ---
POSTGRES_USER=cuckoo
POSTGRES_PASSWORD=cuckoo
POSTGRES_DB=cuckoo
# Host ports. Change them if 5432/6379 are already taken on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Connection URLs (must match the values above) ---
DATABASE_URL=postgresql://cuckoo:cuckoo@localhost:5432/cuckoo
REDIS_URL=redis://localhost:6379
# Server for DB integration tests (pnpm test:integration). Each run creates and
# drops its own cuckoo_test_* database there. Defaults to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://cuckoo:cuckoo@localhost:5432/cuckoo
# Redis for API integration tests; keys are namespaced per run. Defaults to REDIS_URL.
# TEST_REDIS_URL=redis://localhost:6379

# --- apps/api (NestJS) ---
API_HOST=0.0.0.0
API_PORT=3001
# Public origin of the web app. The browser reaches the API through it; auth is at /api/auth.
APP_URL=http://localhost:3000
# Better Auth rate limiting (Redis-backed). Keep "on" outside of local experiments.
AUTH_RATE_LIMIT=on
# Google sign-in (optional): set both or neither. Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- apps/worker (BullMQ) health server ---
WORKER_HOST=0.0.0.0
WORKER_PORT=3002

# --- apps/web (Next.js) runs on port 3000 ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Secrets (never commit real values) ---
# Signs session cookies. At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32-byte key, base64, for AES-256-GCM: provider credentials and email job payloads.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Bump when rotating ENCRYPTION_KEY; stored next to every ciphertext.
ENCRYPTION_KEY_VERSION=1
# Better Auth telemetry is off by default; keep it explicitly off.
BETTER_AUTH_TELEMETRY=0
