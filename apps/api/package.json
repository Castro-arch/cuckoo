{
  "name": "@cuckoo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@cuckoo/core": "workspace:*",
    "@cuckoo/db": "workspace:*",
    "@cuckoo/shared": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "~1.7.10",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-orm": "~0.45.4",
    "tsc-watch": "^7.2.1",
    "vitest": "^5.0.5"
  }
}
